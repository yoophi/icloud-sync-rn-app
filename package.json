{
  "name": "icloud-sync-rn-app",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "start": "pnpm --filter @icloud-sync/mobile start",
    "ios": "pnpm --filter @icloud-sync/mobile ios",
    "android": "pnpm --filter @icloud-sync/mobile android",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present run test --runInBand",
    "pods": "cd apps/mobile && bundle install && cd ios && bundle exec pod install",
    "test:native": "sh scripts/test-native.sh",
    "check:ios": "sh scripts/check-ios-module.sh",
    "macos": "pnpm --filter @icloud-sync/macos macos",
    "start:macos": "pnpm --filter @icloud-sync/macos start",
    "pods:macos": "cd apps/macos && bundle install && cd macos && bundle exec pod install",
    "check:macos": "sh scripts/check-macos-module.sh"
  }
}
